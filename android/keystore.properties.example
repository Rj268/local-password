# Copy to keystore.properties (gitignored) and fill in real values.
# Create the keystore once with:
#   bash android/scripts/create-release-keystore.sh
#
# Keep release.keystore and this file OFF GitHub and backed up offline.
# Losing the keystore means you cannot update the Play listing under the same app id.

storeFile=release.keystore
storePassword=replace-me
keyAlias=localpassword
keyPassword=replace-me
